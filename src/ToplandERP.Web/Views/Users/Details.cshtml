@model UserDto
<div class="page-header">
    <div>
        <h1>@Model.FullName</h1>
        <p class="text-muted mb-0"><code>@Model.EmployeeCode</code> · @Model.UserName</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <a class="btn btn-secondary" asp-action="ResetPassword" asp-route-id="@Model.Id">Reset password</a>
        <form asp-action="SetActive" method="post" data-confirm="@(Model.IsActive ? "Deactivate this employee? They will not be able to sign in." : "Activate this employee?")">
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="isActive" value="@(!Model.IsActive)" />
            <button class="btn @(Model.IsActive ? "btn-warning" : "btn-success")" type="submit">@(Model.IsActive ? "Deactivate" : "Activate")</button>
        </form>
        <a class="btn btn-secondary" asp-action="Index">Back</a>
    </div>
</div>
<section class="card-panel">
    <dl class="detail-list">
        <dt>Company</dt><dd>@(string.IsNullOrWhiteSpace(Model.CompanyName) ? "—" : $"{Model.CompanyName} ({Model.CompanyCode})")</dd>
        <dt>Role</dt><dd>@Model.Role</dd>
        <dt>Email</dt><dd>@Model.Email</dd>
        <dt>Mobile</dt><dd>@(Model.Mobile ?? "—")</dd>
        <dt>Status</dt><dd><partial name="_StatusBadge" model="Model.IsActive" /></dd>
        <dt>Created</dt><dd>@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
    </dl>
</section>
