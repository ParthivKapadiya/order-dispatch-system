@model ResetUserPasswordRequest
@{
    var user = ViewBag.User as UserDto;
}
<div class="page-header">
    <div>
        <h1>Reset password</h1>
        <p class="text-muted mb-0">@(user?.FullName) (@(user?.UserName))</p>
    </div>
</div>
<section class="card-panel">
    <form asp-action="ResetPassword" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label required">New password</label>
            <input asp-for="NewPassword" class="form-control" type="password" autocomplete="new-password" autofocus data-val="false" />
            <div class="form-text">Example that works: Sales@1234</div>
            <span asp-validation-for="NewPassword" class="invalid-feedback d-block"></span>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit">Reset password</button>
            <a class="btn btn-secondary" asp-action="Details" asp-route-id="@ViewContext.RouteData.Values["id"]">Cancel</a>
        </div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
