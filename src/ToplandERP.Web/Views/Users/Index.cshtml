@using ToplandERP.Application.Common
@using ToplandERP.Application.Companies
@using ToplandERP.Application.Users
@model PagedResult<UserDto>
@{
    var query = ViewBag.Query as UserListQuery ?? new UserListQuery();
    var companies = ViewBag.Companies as IReadOnlyList<CompanyDto> ?? [];
    var roles = ViewBag.Roles as IReadOnlyList<string> ?? [];
    var canManage = ViewBag.CanManage as bool? == true;
}
<div class="page-header">
    <div>
        <h1>Employees</h1>
        <p class="text-muted mb-0">Identity users scoped by company and role. Prefer deactivation over deletion.</p>
    </div>
    @if (canManage) { <a class="btn btn-primary" asp-action="Create">Create employee</a> }
</div>
<section class="card-panel">
    <form method="get" class="table-toolbar">
        <input class="form-control search-input" type="search" name="Search" value="@query.Search" placeholder="Search name, code, username, mobile" />
        <select class="form-select" name="Role" style="max-width: 14rem;">
            <option value="">All roles</option>
            @foreach (var role in roles)
            {
                @if (query.Role == role)
                {
                    <option value="@role" selected>@role</option>
                }
                else
                {
                    <option value="@role">@role</option>
                }
            }
        </select>
        <select class="form-select" name="IsActive" style="max-width: 12rem;">
            <option value="">All statuses</option>
            @if (query.IsActive == true)
            {
                <option value="true" selected>Active</option>
            }
            else
            {
                <option value="true">Active</option>
            }
            @if (query.IsActive == false)
            {
                <option value="false" selected>Inactive</option>
            }
            else
            {
                <option value="false">Inactive</option>
            }
        </select>
        @if (CurrentUser.IsSuperAdmin)
        {
            <select class="form-select" name="CompanyId" style="max-width: 16rem;">
                <option value="">All companies</option>
                @foreach (var company in companies)
                {
                    @if (query.CompanyId == company.Id)
                    {
                        <option value="@company.Id" selected>@company.Name</option>
                    }
                    else
                    {
                        <option value="@company.Id">@company.Name</option>
                    }
                }
            </select>
        }
        <button class="btn btn-secondary" type="submit">Filter</button>
    </form>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Employee code</th>
                    <th>Name</th>
                    <th>Username</th>
                    <th>Company</th>
                    <th>Role</th>
                    <th>Mobile</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="9" class="text-muted">No employees match the current filters.</td></tr>
            }
            else
            {
                foreach (var user in Model.Items)
                {
                    <tr>
                        <td><code>@user.EmployeeCode</code></td>
                        <td>@user.FullName</td>
                        <td>@user.UserName</td>
                        <td>@(string.IsNullOrWhiteSpace(user.CompanyCode) ? "—" : user.CompanyCode)</td>
                        <td>@user.Role</td>
                        <td>@(user.Mobile ?? "—")</td>
                        <td><partial name="_StatusBadge" model="user.IsActive" /></td>
                        <td>@user.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-secondary" asp-action="Details" asp-route-id="@user.Id">View</a>
                            @if (canManage)
                            {
                                <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@user.Id">Edit</a>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" model="Model" />
</section>
