<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Dashboard") - Topland ERP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-body">
    <div class="app-shell">
        <aside class="app-sidebar" id="appSidebar">
            <div class="sidebar-brand">
                <span class="brand-mark">T</span>
                <div>
                    <strong>Topland ERP</strong>
                    <small>Order &amp; Dispatch</small>
                </div>
            </div>
            <nav class="sidebar-nav" aria-label="Main">
                @{
                    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString();
                    bool Can(params string[] roles) => roles.Any(role => User.IsInRole(role));
                }
                <a class="nav-link @(controllerName == "Home" ? "active" : null)" asp-controller="Home" asp-action="Index">Dashboard</a>
                @if (Can(RoleNames.SuperAdmin, RoleNames.CompanyAdmin, RoleNames.SalesEmployee, RoleNames.DispatchUser))
                {
                    <a class="nav-link @(controllerName == "Companies" ? "active" : null)" asp-controller="Companies" asp-action="Index">Companies</a>
                }
                @if (Can(RoleNames.SuperAdmin, RoleNames.CompanyAdmin))
                {
                    <a class="nav-link @(controllerName == "Users" ? "active" : null)" asp-controller="Users" asp-action="Index">Employees</a>
                }
                @if (Can(RoleNames.SuperAdmin, RoleNames.CompanyAdmin, RoleNames.SalesEmployee))
                {
                    <a class="nav-link @(controllerName == "Customers" ? "active" : null)" asp-controller="Customers" asp-action="Index">Customers</a>
                    <a class="nav-link @(controllerName == "Products" ? "active" : null)" asp-controller="Products" asp-action="Index">Products</a>
                }
                @if (Can(RoleNames.SuperAdmin, RoleNames.CompanyAdmin, RoleNames.SalesEmployee, RoleNames.DispatchUser))
                {
                    <a class="nav-link @(controllerName == "Transporters" ? "active" : null)" asp-controller="Transporters" asp-action="Index">Transporters</a>
                }
                @if (Can(RoleNames.SuperAdmin, RoleNames.CompanyAdmin, RoleNames.SalesEmployee))
                {
                    <a class="nav-link @(controllerName == "PaymentConditions" ? "active" : null)" asp-controller="PaymentConditions" asp-action="Index">Payment Conditions</a>
                }
                @if (Can(RoleNames.SuperAdmin, RoleNames.CompanyAdmin, RoleNames.SalesEmployee))
                {
                    <a class="nav-link @(controllerName == "Orders" ? "active" : null)" asp-controller="Orders" asp-action="Index">Orders</a>
                }
                @if (Can(RoleNames.SuperAdmin, RoleNames.CompanyAdmin, RoleNames.DispatchUser))
                {
                    <a class="nav-link @(controllerName == "Dispatch" ? "active" : null)" asp-controller="Dispatch" asp-action="Index">Dispatch</a>
                }
                @if (Can(RoleNames.SuperAdmin, RoleNames.CompanyAdmin))
                {
                    <a class="nav-link @(controllerName == "ModificationRequests" ? "active" : null)" asp-controller="ModificationRequests" asp-action="Index">Modification Requests</a>
                }
                <a class="nav-link @(controllerName == "Notifications" ? "active" : null)" asp-controller="Notifications" asp-action="Index">Notifications</a>
                <span class="nav-section">Coming later</span>
                <span class="nav-link disabled" title="Implemented in a later phase">Reports</span>
                <span class="nav-link disabled" title="Implemented in a later phase">Audit Logs</span>
                <span class="nav-link disabled" title="Implemented in a later phase">Settings</span>
                <a class="nav-link @(controllerName == "Health" ? "active" : null)" asp-controller="Health" asp-action="Index">Health</a>
            </nav>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <button class="btn btn-icon d-lg-none" type="button" id="sidebarToggle" aria-label="Open navigation">
                    <span class="hamburger"></span>
                </button>
                <nav class="breadcrumb-nav" aria-label="Breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                        @if (ViewData["Breadcrumb"] is string breadcrumb)
                        {
                            <li class="breadcrumb-item active" aria-current="page">@breadcrumb</li>
                        }
                    </ol>
                </nav>
                <div class="topbar-actions">
                    <partial name="_NotificationBell" />
                    <div class="dropdown">
                        <button class="user-chip dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="user-avatar">@(CurrentUser.FullName?.FirstOrDefault() ?? 'U')</span>
                            <span class="user-meta">
                                <strong>@(CurrentUser.FullName ?? CurrentUser.UserName)</strong>
                                <small>@(CurrentUser.IsSuperAdmin ? "Super Admin" : string.Join(", ", CurrentUser.Roles))</small>
                            </span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><span class="dropdown-item-text text-muted">Signed in as @CurrentUser.UserName</span></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item">Sign out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="app-content">
                <partial name="_Alerts" />
                @RenderBody()
            </main>
        </div>
    </div>

    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
