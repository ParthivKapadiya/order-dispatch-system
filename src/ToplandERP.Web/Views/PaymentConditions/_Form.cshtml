@model PaymentConditionWriteRequest
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<partial name="_CompanySelect" model="Model.CompanyId" />
<div class="mb-3">
    <label asp-for="Name" class="form-label required">Name</label>
    <input asp-for="Name" class="form-control" autofocus placeholder="Cash, Credit, Advance, Other" />
    <span asp-validation-for="Name" class="invalid-feedback d-block"></span>
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label">Description</label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Description" class="invalid-feedback d-block"></span>
</div>
