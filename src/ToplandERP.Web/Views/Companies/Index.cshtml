@model IReadOnlyList<CompanyDto>
<div class="page-header">
    <div>
        <h1>Companies</h1>
        <p class="text-muted mb-0">Company records are seeded and read-only in this phase.</p>
    </div>
</div>
<section class="card-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Code</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="4" class="text-muted">No companies are available for this account.</td></tr>
            }
            else
            {
                foreach (var company in Model)
                {
                    <tr>
                        <td>@company.Name</td>
                        <td><code>@company.Code</code></td>
                        <td><partial name="_StatusBadge" model="company.IsActive" /></td>
                        <td class="text-end"><a class="btn btn-sm btn-secondary" asp-action="Details" asp-route-id="@company.Id">View</a></td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>
