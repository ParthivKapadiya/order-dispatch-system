@using ToplandERP.Application.Common
@using ToplandERP.Application.Companies
@using ToplandERP.Application.Customers
@model PagedResult<CustomerDto>
@{
    var query = ViewBag.Query as PagedQuery ?? new PagedQuery();
    var companies = ViewBag.Companies as IReadOnlyList<CompanyDto> ?? [];
    var canCreate = ViewBag.CanCreate as bool? == true;
    var canEdit = ViewBag.CanEdit as bool? == true;
}

<div class="page-header">
    <div>
        <h1>Customers</h1>
        <p class="text-muted mb-0">Company-scoped customer master with separate billing and delivery addresses.</p>
    </div>
    @if (canCreate)
    {
        <a class="btn btn-primary" asp-action="Create">Create customer</a>
    }
</div>

<section class="card-panel">
    <form method="get" class="table-toolbar">
        <input class="form-control search-input" type="search" name="Search" value="@query.Search" placeholder="Search name, code, mobile, city" />
        <select class="form-select" name="IsActive" style="max-width: 12rem;">
            <option value="">All statuses</option>
            @if (query.IsActive == true)
            {
                <option value="true" selected>Active</option>
            }
            else
            {
                <option value="true">Active</option>
            }
            @if (query.IsActive == false)
            {
                <option value="false" selected>Inactive</option>
            }
            else
            {
                <option value="false">Inactive</option>
            }
        </select>
        @if (CurrentUser.IsSuperAdmin)
        {
            <select class="form-select" name="CompanyId" style="max-width: 16rem;">
                <option value="">All companies</option>
                @foreach (var company in companies)
                {
                    @if (query.CompanyId == company.Id)
                    {
                        <option value="@company.Id" selected>@company.Name</option>
                    }
                    else
                    {
                        <option value="@company.Id">@company.Name</option>
                    }
                }
            </select>
        }
        <button class="btn btn-secondary" type="submit">Filter</button>
    </form>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    @if (CurrentUser.IsSuperAdmin)
                    {
                        <th>Company</th>
                    }
                    <th>Mobile</th>
                    <th>Billing city</th>
                    <th>Delivery city</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="8" class="text-muted">No customers match the current filters.</td>
                </tr>
            }
            else
            {
                foreach (var customer in Model.Items)
                {
                    <tr>
                        <td><code>@customer.CustomerCode</code></td>
                        <td>@customer.CustomerName</td>
                        @if (CurrentUser.IsSuperAdmin)
                        {
                            <td>@customer.CompanyCode</td>
                        }
                        <td>@customer.Mobile</td>
                        <td>@customer.BillingCity</td>
                        <td>@customer.DeliveryCity</td>
                        <td><partial name="_StatusBadge" model="customer.IsActive" /></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-secondary" asp-action="Details" asp-route-id="@customer.Id">View</a>
                            @if (canEdit)
                            {
                                <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@customer.Id">Edit</a>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" model="Model" />
</section>
