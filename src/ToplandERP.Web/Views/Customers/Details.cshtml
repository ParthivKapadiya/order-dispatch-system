@model CustomerDto
@{
    var canEdit = ViewBag.CanEdit as bool? == true;
}

<div class="page-header">
    <div>
        <h1>@Model.CustomerName</h1>
        <p class="text-muted mb-0"><code>@Model.CustomerCode</code> · @Model.CompanyName</p>
    </div>
    <div class="d-flex gap-2">
        @if (canEdit)
        {
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
            <form asp-action="SetActive" method="post" data-confirm="@(Model.IsActive ? "Deactivate this customer?" : "Activate this customer?")">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="isActive" value="@(!Model.IsActive)" />
                <button class="btn @(Model.IsActive ? "btn-warning" : "btn-success")" type="submit">
                    @(Model.IsActive ? "Deactivate" : "Activate")
                </button>
            </form>
        }
        <a class="btn btn-secondary" asp-action="Index">Back</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <section class="card-panel">
            <div class="panel-header"><h2>Contact</h2></div>
            <dl class="detail-list">
                <dt>Mobile</dt><dd>@Model.Mobile</dd>
                <dt>Email</dt><dd>@(Model.Email ?? "—")</dd>
                <dt>Status</dt><dd><partial name="_StatusBadge" model="Model.IsActive" /></dd>
            </dl>
        </section>
    </div>
    <div class="col-lg-4">
        <section class="card-panel">
            <div class="panel-header"><h2>Billing address</h2></div>
            <p class="mb-1">@Model.BillingAddress</p>
            <p class="mb-0 text-muted">@Model.BillingCity, @Model.BillingState @Model.BillingPincode</p>
        </section>
    </div>
    <div class="col-lg-4">
        <section class="card-panel">
            <div class="panel-header"><h2>Delivery address</h2></div>
            <p class="mb-1">@Model.DeliveryAddress</p>
            <p class="mb-0 text-muted">@Model.DeliveryCity, @Model.DeliveryState @Model.DeliveryPincode</p>
        </section>
    </div>
</div>
