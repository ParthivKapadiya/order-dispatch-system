@model CustomerWriteRequest

<div class="page-header">
    <div>
        <h1>Edit customer</h1>
        <p class="text-muted mb-0">Company assignment cannot be changed after create.</p>
    </div>
</div>

<section class="card-panel">
    <form asp-action="Edit" method="post" novalidate>
        <partial name="_Form" model="Model" />
        <div class="mt-4 d-flex gap-2">
            <button class="btn btn-primary" type="submit">Save changes</button>
            <a class="btn btn-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById("copyBillingAddress")?.addEventListener("click", () => {
            document.getElementById("DeliveryAddress").value = document.getElementById("BillingAddress").value;
            document.getElementById("DeliveryCity").value = document.getElementById("BillingCity").value;
            document.getElementById("DeliveryState").value = document.getElementById("DeliveryState").value;
            document.getElementById("DeliveryPincode").value = document.getElementById("BillingPincode").value;
        });
    </script>
}
